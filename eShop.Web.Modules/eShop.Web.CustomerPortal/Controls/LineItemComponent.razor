@inject IDeleteProductUseCase deleteProductUseCase
@inject IUpdateQuantityUseCase updateQuantityUseCase

@if (LineItem != null && LineItem.Product != null)
{
    <li class="row align-items-center mb-3">
        <!-- Cột hình ảnh -->
        <div class="col-3 text-center">
            <img src="@LineItem.Product.ImageLink" class="img-fluid rounded" alt="@LineItem.Product.Name" style="max-height: 100px; object-fit: contain;" />
        </div>

        <!-- Cột thông tin sản phẩm -->
        <div class="col-6">
            <h6 class="fw-bold mb-2">@LineItem.Product.Name</h6>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="text-secondary small">Quantity:</span>
                <input type="number" min="1" class="form-control form-control-sm" style="width: 70px;" value="@LineItem.Quantity" @onchange="HandleQuantityChange" />
            </div>
            <div>
                <span class="text-secondary small">Price: </span>
                <strong class="text-danger">@LineItem.Product.Price.ToString("C")</strong>
            </div>
        </div>

        <!-- Cột nút Xóa -->
        <div class="col-3 text-end">
            <!-- Đổi LineItem.Id thành LineItem.ProductId -->
            <button class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteProduct(LineItem.ProductId))">
                Delete
            </button>
        </div>
    </li>
}

@code {
    [Parameter]
    public OrderLineItem LineItem { get; set; }

    [Parameter]
    public EventCallback<Order> OnDeleteProduct { get; set; }

    [Parameter]
    public EventCallback<Order> OnUpdateQuantity { get; set; }

    async Task HandleQuantityChange(ChangeEventArgs e)
    {
        if (e.Value == null || string.IsNullOrEmpty(e.Value.ToString())) return;
        if (int.TryParse(e.Value.ToString(), out int qty))
        {
            if (qty < 0) return;
            // Đổi LineItem.Id thành LineItem.ProductId
            var order = await updateQuantityUseCase.Execute(LineItem.ProductId, qty);
            await OnUpdateQuantity.InvokeAsync(order);
        }
    }

    // Đổi async void thành async Task và sửa lại luồng await
    async Task DeleteProduct(int productId)
    {
        var order = await deleteProductUseCase.Execute(productId);
        await OnDeleteProduct.InvokeAsync(order);
    }
}