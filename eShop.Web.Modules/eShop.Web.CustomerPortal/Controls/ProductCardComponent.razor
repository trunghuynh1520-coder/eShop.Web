<div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card">
    <!-- Khu vực hình ảnh sản phẩm -->
    <div class="bg-white p-3 d-flex align-items-center justify-content-center position-relative" style="height: 220px;">
        <img src="@product.ImageLink" class="img-fluid" alt="@product.Name" style="max-height: 100%; object-fit: contain;" />
        <span class="position-absolute top-0 start-0 m-3 badge bg-secondary text-uppercase px-2 py-1 rounded-pill">
            @product.Brand
        </span>
    </div>

    <!-- Nội dung thông tin sản phẩm -->
    <div class="card-body p-3 d-flex flex-column bg-light">
        <!-- Tên sản phẩm (Tự động cắt bớt nếu quá dài) -->
        <h6 class="card-title fw-bold text-dark mb-2 text-truncate" title="@product.Name">
            @product.Name
        </h6>

        <!-- Mô tả ngắn (Tối đa 2 dòng) -->
        <p class="card-text text-secondary small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.875rem;">
            @product.Description
        </p>

        <!-- Giá bán và Nút bấm -->
        <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
            <div>
                <span class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Giá</span>
                <span class="fs-5 fw-bolder text-danger">@product.Price.ToString("C")</span>
            </div>

            <NavLink class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm" href="@($"products/{product.Id}")">
                Chi tiết
            </NavLink>
        </div>
    </div>
</div>
@code {
    [Parameter]
    public Product product { get; set; }
}
