@using Microsoft.AspNetCore.Components.Routing
@using eShop.CoreBusiness.Models

<div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
    <!-- Hình ảnh -->
    <div class="bg-white p-3 d-flex align-items-center justify-content-center" style="height: 200px;">
        <img src="@Product.ImageLink" class="img-fluid" alt="@Product.Name" style="max-height: 100%; object-fit: contain;" />
    </div>

    <!-- Nội dung -->
    <div class="card-body p-3 d-flex flex-column bg-light">
        <span class="badge bg-secondary text-uppercase mb-2 align-self-start">@Product.Brand</span>
        <h6 class="card-title fw-bold text-dark text-truncate mb-3" title="@Product.Name">@Product.Name</h6>

        <!-- Giá & Nút bấm -->
        <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
            <span class="fs-5 fw-bolder text-danger">@Product.Price.ToString("C")</span>
            <NavLink class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" href="@($"products/{Product.Id}")">
                Chi tiết
            </NavLink>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Product Product { get; set; }
}
