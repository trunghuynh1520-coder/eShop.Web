@using Microsoft.AspNetCore.Components.Web

<div class="row g-3 align-items-center mb-4">
    <div class="col-md-8 col-lg-6">
        <label for="filter-input" class="visually-hidden">Search Products</label>
        <div class="input-group input-group-lg shadow-sm">
            <span class="input-group-text bg-white text-muted border-end-0">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" id="filter-input" class="form-control border-start-0 ps-0" placeholder="Search for products..." @bind="filter" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="HandleSearch">Search</button>
        </div>
    </div>
</div>

@code {
    private string filter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private async Task HandleSearch()
    {
        await OnSearch.InvokeAsync(filter);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSearch();
        }
    }
}