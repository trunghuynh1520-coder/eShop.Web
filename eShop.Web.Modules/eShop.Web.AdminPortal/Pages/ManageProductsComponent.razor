@page "/admin/products"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using eShop.UseCases.SearchProductScreen
@inject ISearchProductUseCase SearchProductUseCase

<h3>Quản lý Sản phẩm</h3>

@if (products != null && products.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Thương hiệu</th>
                <th>Giá</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Id</td>
                    <td><img src="@product.ImageLink" style="width: 50px; height: 50px;" /></td>
                    <td>@product.Name</td>
                    <td>@product.Brand</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>
                        <button class="btn btn-primary" disabled>Sửa (Đang phát triển)</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Không có sản phẩm nào.</p>
}

@code {
    private IEnumerable<Product>? products;

    protected override void OnInitialized()
    {
        products = SearchProductUseCase.Execute(string.Empty);
    }
}
